<Window x:Class="PlcHmiDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PlcHmiDashboard.Converters"
        Title="Plant SCADA - Body Shop Station (Robotic Spot Welding)" Height="820" Width="1150"
        Background="#1B1F24">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="HmiButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="#22262C"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3138"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="#3A3F47"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="BODY SHOP — STATION 3: ROBOTIC SPOT WELDING" Foreground="White" FontSize="20" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="#F1C40F" FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" Foreground="#2ECC71" FontSize="14" VerticalAlignment="Center"/>
        </Grid>

        <TabControl Grid.Row="1">

            <!-- ===================== OVERVIEW TAB ===================== -->
            <TabItem Header="OVERVIEW">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="PROCESS MIMIC — WELD CELL" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#22262C" CornerRadius="6" Padding="24" Height="260">
                            <Canvas>
                                <!-- Conveyor rail -->
                                <Line X1="20" Y1="200" X2="480" Y2="200" Stroke="#4A5058" StrokeThickness="4"/>

                                <!-- Car body in the fixture: outline turns blue when clamped -->
                                <!-- Car body group: wrapped so the whole body + label can slide out/in together -->
                                <Canvas x:Name="CarBodyGroup">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="CarBodyTransform" X="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Indexing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="SlideOutStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                 To="260" Duration="0:0:0.9"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SlideOutStoryboard"/>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-260"/>
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Rectangle Canvas.Left="130" Canvas.Top="140" Width="140" Height="55" RadiusX="10" RadiusY="10"
           Fill="#2C3138" Stroke="{Binding ClampedBrush}" StrokeThickness="3"/>
                                    <TextBlock Canvas.Left="150" Canvas.Top="158" Text="CAR BODY" Foreground="#7F8C8D" FontSize="11" FontWeight="Bold"/>
                                </Canvas>
                                <TextBlock Canvas.Left="130" Canvas.Top="200" Text="Fixture / Clamp" Foreground="#BDC3C7"/>

                                <!-- Simple schematic robot arm: pedestal, base, shoulder joint, weld gun tip -->
                                <Polygon Points="322,230 358,230 350,220 330,220" Fill="#3A3F47" Stroke="#4A5058" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="318" Canvas.Top="228" Width="44" Height="4" Fill="#2C3138"/>
                                <Ellipse Canvas.Left="330" Canvas.Top="200" Width="20" Height="20" Fill="#4A5058"/>
                                <Line X1="340" Y1="205" X2="300" Y2="150" Stroke="{Binding RobotStatusBrush}" StrokeThickness="6"/>
                                <Line x:Name="ArmSegment2" X1="300" Y1="150" X2="245" Y2="140" Stroke="{Binding RobotStatusBrush}" StrokeThickness="6"/>
                                <Ellipse x:Name="ArmTipEllipse" Canvas.Left="238" Canvas.Top="132" Width="16" Height="16" Fill="{Binding RobotStatusBrush}"/>
                                <TextBlock Canvas.Left="290" Canvas.Top="210" Text="Weld Robot" Foreground="#BDC3C7"/>

                                <!-- Welding spark: flashes at the gun tip only while actively welding -->
                                <Ellipse x:Name="WeldSpark" Canvas.Left="232" Canvas.Top="126" Width="28" Height="28"
         Fill="#FFF6A0" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Welding}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="WeldFlashStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.15" To="0.9" Duration="0:0:0.12"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="WeldFlashStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- Fault lamp -->
                                <!-- Fault lamp -->
                                <Ellipse Canvas.Left="420" Canvas.Top="20" Width="34" Height="34"
         Fill="{Binding FaultBrush}" Stroke="White" StrokeThickness="1.5"/>
                                <TextBlock Canvas.Left="400" Canvas.Top="60" Text="Fault Lamp" Foreground="#BDC3C7"/>
                                <TextBlock Canvas.Left="400" Canvas.Top="78" Foreground="#E74C3C" FontWeight="Bold" FontSize="12"
           Visibility="{Binding FaultActive, Converter={StaticResource BoolToVisibility}}">
    <Run Text="Fault at weld #"/>
    <Run Text="{Binding FaultWeldIndex, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Readouts -->
                                <TextBlock Canvas.Left="10" Canvas.Top="10" Text="Clamp Pressure" Foreground="#BDC3C7"/>
                                <TextBlock Canvas.Left="10" Canvas.Top="28" Text="{Binding ClampPressure, StringFormat={}{0:0.00} bar}"
                                           Foreground="White" FontWeight="Bold" FontSize="16"/>

                                <TextBlock Canvas.Left="150" Canvas.Top="10" Text="Robot TCP Speed" Foreground="#BDC3C7"/>
                                <TextBlock Canvas.Left="150" Canvas.Top="28" Text="{Binding RobotSpeed, StringFormat={}{0:0} mm/s}"
                                           Foreground="White" FontWeight="Bold" FontSize="16"/>

                                <TextBlock Canvas.Left="310" Canvas.Top="10" Text="Weld Tip Temp" Foreground="#BDC3C7"/>
                                <TextBlock Canvas.Left="310" Canvas.Top="28" Text="{Binding WeldTipTemperature, StringFormat={}{0:0.0} °C}"
                                           Foreground="White" FontWeight="Bold" FontSize="16"/>
                            </Canvas>
                        </Border>

                        <TextBlock Text="WELD PROGRESS" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
                        <Border Background="#22262C" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding WeldProgressPercent, Mode=OneWay}"
                                             Height="22" Background="#33383F" Foreground="#E67E22" BorderThickness="0"/>
                                <TextBlock Margin="0,6,0,10" Foreground="#BDC3C7">
    <Run Text="{Binding WeldCount, Mode=OneWay}"/>
    <Run Text="/"/>
    <Run Text="{Binding WeldTargetValue, Mode=OneWay}"/>
    <Run Text=" spot welds this cycle"/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding WeldPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="16" Height="16" Margin="3" Fill="{Binding Fill}" ToolTip="{Binding Number}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#4A5058" Margin="0,0,4,0"/>
                                    <TextBlock Text="Pending" Foreground="#7F8C8D" FontSize="11" Margin="0,0,12,0"/>
                                    <Ellipse Width="10" Height="10" Fill="#E67E22" Margin="0,0,4,0"/>
                                    <TextBlock Text="In progress" Foreground="#7F8C8D" FontSize="11" Margin="0,0,12,0"/>
                                    <Ellipse Width="10" Height="10" Fill="#2ECC71" Margin="0,0,4,0"/>
                                    <TextBlock Text="Complete" Foreground="#7F8C8D" FontSize="11" Margin="0,0,12,0"/>
                                    <Ellipse Width="10" Height="10" Fill="#E74C3C" Margin="0,0,4,0"/>
                                    <TextBlock Text="Fault" Foreground="#7F8C8D" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                          
                        </Border>

                        <TextBlock Text="QUICK KPIs" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Bodies Produced" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding BodiesProduced}" Style="{StaticResource KpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Faults Today" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding FaultCount}" Style="{StaticResource KpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Last Cycle vs Takt" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding TaktStatusText}" FontSize="20" FontWeight="Bold" Foreground="{Binding TaktStatusBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="START" Command="{Binding StartCommand}" Style="{StaticResource HmiButton}" Background="#27AE60" Margin="0,0,10,0"/>
                            <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource HmiButton}" Background="#C0392B" Margin="0,0,10,0"/>
                            <Button Content="RESET" Command="{Binding ResetCommand}" Style="{StaticResource HmiButton}" Background="#2980B9"/>
</StackPanel>
</StackPanel>


                    <StackPanel Grid.Column="1">
                        <TextBlock Text="RECENT EVENTS" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#22262C" CornerRadius="6" Padding="8">
                            <ListBox ItemsSource="{Binding AlarmLog}" Background="Transparent" BorderThickness="0" Height="520">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="White" TextWrapping="Wrap">
                                            <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#7F8C8D"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding SeverityText, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== TRENDS TAB ===================== -->
            <TabItem Header="TRENDS">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Trends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Grid.Column="1" Foreground="White" FontWeight="Bold">
                                            <Run Text="{Binding LatestValue, Mode=OneWay, StringFormat={}{0:0.0}}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Unit, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Border Background="#22262C" CornerRadius="6" Padding="12" Height="110">
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="560" Height="90" ClipToBounds="True">
                                                <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="2"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ALARMS TAB ===================== -->
            <TabItem Header="ALARMS">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ALARM &amp; EVENT LOG (newest first)" Style="{StaticResource SectionHeader}"/>
                    <Border Grid.Row="1" Background="#22262C" CornerRadius="6" Padding="4">
                        <DataGrid ItemsSource="{Binding AlarmLog}" AutoGenerateColumns="False"
          Background="Transparent" Foreground="White" BorderThickness="0"
          RowBackground="#22262C" AlternatingRowBackground="#262B32"
          GridLinesVisibility="None" HeadersVisibility="Column" IsReadOnly="True"
          ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="100"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="100"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Acknowledged" Foreground="#2ECC71" Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVisibility}}"/>
                                                <Button Content="Ack" Padding="8,2"
                                                        Command="{Binding DataContext.AckAlarmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding RequiresAckAndUnacked, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== PRODUCTION / KPI TAB ===================== -->
            <TabItem Header="PRODUCTION">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="PRODUCTION &amp; EQUIPMENT KPIs" Style="{StaticResource SectionHeader}"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Bodies Produced" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding BodiesProduced}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Fault Count" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding FaultCount}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Last Cycle Time" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding LastCycleTimeSeconds, StringFormat={}{0:0.0}s}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Uptime (Running)" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Downtime (Fault)" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding DowntimeText}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Idle Time" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding IdleTimeText}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="AVAILABILITY" Style="{StaticResource SectionHeader}" Margin="0,10,0,8"/>
                    <Border Background="#22262C" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding AvailabilityPercent, Mode=OneWay}"
                                         Height="26" Background="#33383F" Foreground="#2ECC71" BorderThickness="0"/>
                            <TextBlock Text="{Binding AvailabilityPercent, StringFormat=Availability: {0:0.0}% of tracked time spent running}"
                                       Foreground="#BDC3C7" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TAKT TIME" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"/>
                    <Border Background="#22262C" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock Foreground="#BDC3C7" TextWrapping="Wrap">
                                <Run Text="Takt time (target: 8.0s/body) is the maximum time allowed per body to keep pace with line demand. "/>
                                <Run Text="Last completed body: "/>
                                <Run Text="{Binding LastCycleTimeSeconds, Mode=OneWay, StringFormat={}{0:0.0}s}" FontWeight="Bold" Foreground="White"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding TaktStatusText, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding TaktStatusBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===================== TAG BROWSER TAB ===================== -->
            <TabItem Header="TAG BROWSER">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="LIVE PLC / SIMULATOR TAGS" Style="{StaticResource SectionHeader}"/>
                    <Border Grid.Row="1" Background="#22262C" CornerRadius="6" Padding="4">
                        <DataGrid ItemsSource="{Binding TagRows}" AutoGenerateColumns="False"
          Background="Transparent" Foreground="White" BorderThickness="0"
          RowBackground="#22262C" AlternatingRowBackground="#262B32"
          GridLinesVisibility="None" HeadersVisibility="Column" IsReadOnly="True"
          ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tag Name" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                                <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="80"/>
                                <DataGridTextColumn Header="Last Update" Binding="{Binding LastUpdateText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
